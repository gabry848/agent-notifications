{"time":"2026-10-07T08:37:31.490Z","monoMs":492003277.095,"type":"session_started","model":"gpt-6.1-sol","provider":"openai-codex","api":"openai-codex-responses","baseline":{"package.json":{"hash":"b2af5f484a94937a395c3d85e0005b73ce3d2978310b2c8f520ca72a0afd8de9","content":"{\"private\":true,\"type\":\"module\",\"scripts\":{\"test\":\"node --test test/*.test.mjs\",\"mcp\":\"node src/mcp.mjs --db data/notes.sqlite\",\"web\":\"node src/web.mjs --db data/notes.sqlite --port 8080\"}}\n"},"src/import.mjs":{"hash":"76489036de3ca1f415c3ba39c2a22c4492085007919366940183f654e3f642a2","content":"// Shared legacy bulk importer. Text is checked up front; per-note validation lives in the store.\nexport function importNotes(store, records) {\n  if (!Array.isArray(records)) throw new Error('notes must be an array');\n  const prepared = records.map(record => {\n    if (!record || typeof record.text !== 'string' || !record.text.trim() || record.text.trim().length > 4000)\n      throw new Error('invalid note text');\n    return {text:record.text.trim(),tags:record.tags??[]};\n  });\n  return prepared.map(record => store.createNote(record.text,record.tags));\n}\n"},"src/store.mjs":{"hash":"ab8952a9540c8f36f22a8deb8c90c922b649c3a030c96f216d0431ff7c59348a","content":"// Legacy prototype. Public methods must be completed and hardened for the contract.\nimport { DatabaseSync } from 'node:sqlite';\nimport { mkdirSync } from 'node:fs';\nimport { dirname } from 'node:path';\nexport function openStore(path) {\n  mkdirSync(dirname(path), {recursive:true});\n  const db=new DatabaseSync(path);\n  db.exec(`CREATE TABLE IF NOT EXISTS notes(id INTEGER PRIMARY KEY,text TEXT NOT NULL,created_at TEXT NOT NULL,updated_at TEXT NOT NULL);\n    CREATE TABLE IF NOT EXISTS tags(name TEXT PRIMARY KEY);\n    CREATE TABLE IF NOT EXISTS note_tags(note_id INTEGER REFERENCES notes(id) ON DELETE CASCADE,tag TEXT REFERENCES tags(name),PRIMARY KEY(note_id,tag));`);\n  const getNote=id=>{\n    const row=db.prepare('SELECT * FROM notes WHERE id=?').get(id);\n    if(!row)return null;\n    return {id:Number(row.id),text:row.text,createdAt:row.created_at,updatedAt:row.updated_at,\n      tags:db.prepare('SELECT tag FROM note_tags WHERE note_id=? ORDER BY tag').all(id).map(r=>r.tag)};\n  };\n  return {\n    createNote(text,tags=[]) {\n      const now=new Date().toISOString();\n      const id=Number(db.prepare('INSERT INTO notes(text,created_at,updated_at) VALUES(?,?,?)').run(text,now,now).lastInsertRowid);\n      for(const tag of tags){db.prepare('INSERT OR IGNORE INTO tags VALUES(?)').run(tag);db.prepare('INSERT OR IGNORE INTO note_tags VALUES(?,?)').run(id,tag);}\n      return getNote(id);\n    }, getNote,\n    listNotes(){return db.prepare('SELECT id FROM notes ORDER BY id DESC').all().map(r=>getNote(r.id));},\n    updateNote(){throw new Error('Not implemented');},\n    deleteNote(id){return db.prepare('DELETE FROM notes WHERE id=?').run(id).changes>0;},\n    listTags(){return db.prepare('SELECT name,(SELECT COUNT(*) FROM note_tags WHERE tag=name) AS count FROM tags ORDER BY name').all();},\n    close(){db.close();}\n  };\n}\n"},"test/smoke.test.mjs":{"hash":"1124a0b357a89cdf8ec6bc218e4068abd351c3ecebf0dd05cdf98474543a33dc","content":"import {test} from 'node:test';\nimport assert from 'node:assert/strict';\nimport {openStore} from '../src/store.mjs';\ntest('legacy create/get smoke',()=>{const s=openStore(':memory:'); const n=s.createNote('hello',['work']); assert.equal(s.getNote(n.id).text,'hello'); s.close();});\n"}}}
